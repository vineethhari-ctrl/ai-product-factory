# GEMINI_API_KEY: Primary LLM provider for the Express backend (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Failover provider, used when Gemini is unavailable (server-side only).
# Optional. Never prefix it with VITE_.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── AI usage control (server/usage.ts). Limits are per rolling 24 hours; 0 turns a limit off. ──
# Each AI button (Understand Business, Generate BRD, Build Prototype, Change Impact) per project.
AI_PROJECT_BUTTON_LIMIT=3
# Each AI button per BA, across all their projects.
AI_USER_BUTTON_LIMIT=3
# AI tokens (input + output) per BA.
AI_USER_DAILY_TOKENS=300000
# Team budget per calendar month in USD; when reached, everyone gets the free offline engine.
AI_MONTHLY_BUDGET_USD=50
# Days an identical request reuses its saved AI result for free.
AI_CACHE_DAYS=30
# Where usage and cached results are stored (needs a persistent disk in production).
DATA_DIR=data
# Prices are estimates; override with your provider's list price, USD per million tokens "input,output":
# AI_PRICE_GEMINI_3_1_PRO_PREVIEW="2,12"
