# GEMINI_API_KEY: Gemini provider for the Express backend (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Gemini through Google Cloud Vertex AI instead of the regular Gemini API. Google's own variables, also read from
# the PC's environment: GOOGLE_GENAI_USE_VERTEXAI=true switches to Vertex; then GOOGLE_API_KEY (a Vertex API key) is
# used, or else GOOGLE_CLOUD_PROJECT (+ GOOGLE_CLOUD_LOCATION, default global) with the PC's Google sign-in.
# AI_GEMINI_BACKEND=api|vertex overrides the switch above (api = regular Gemini API with GEMINI_API_KEY).
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# AI_GEMINI_BACKEND=vertex

# ANTHROPIC_API_KEY: Claude provider (server-side only). Optional. Never prefix it with VITE_.
# With one key only, every task runs on that provider.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── AI usage control (server/usage.ts). Limits are per rolling 24 hours; 0 turns a limit off. ──
# Each AI button (Understand Business, Generate BRD, Build Prototype, Change Impact) per project.
AI_PROJECT_BUTTON_LIMIT=3
# Each AI button per BA, across all their projects.
AI_USER_BUTTON_LIMIT=3
# AI tokens (input + output) per BA.
AI_USER_DAILY_TOKENS=300000
# Team budget per calendar month in USD; when reached, everyone gets the free offline engine.
AI_MONTHLY_BUDGET_USD=50
# Days an identical request reuses its saved AI result for free.
AI_CACHE_DAYS=30
# Where usage and cached results are stored (needs a persistent disk in production).
DATA_DIR=data
# Prices are estimates; override with your provider's list price, USD per million tokens "input,output":
# AI_PRICE_GEMINI_3_1_PRO_PREVIEW="2,12"

# When a key is set but every AI provider fails (busy, quota, bad answer), the request fails with a clear
# message and Retry; the offline engine is used only when no key is set. true = old behaviour (offline answer).
# AI_OFFLINE_ON_FAILURE=false

# ── Per-task model routing (server/routing.ts). Defaults: Understand Business Gemini -> Claude Sonnet,
# Generate BRD and Build Prototype Claude Sonnet -> Gemini, Change Impact Claude Haiku -> Gemini Flash. ──
# Provider order per task:
# AI_ORDER_GENERATE_DEFINITION=claude,gemini
# Model per task, e.g. Opus for the BRD (about 2x Sonnet's cost):
# AI_CLAUDE_MODEL_GENERATE_DEFINITION=claude-opus-5-5
# AI_GEMINI_MODEL_ANALYZE_MATERIAL=gemini-4-argon   (default for the heavy steps; Pro and Flash are the backups)
# Second Gemini model, tried when the first is busy (503), out of quota or unavailable. Default: Pro -> Flash,
# Flash -> Pro. "none" turns it off:
# AI_GEMINI_FALLBACK_GENERATE_PROTOTYPE_UI=gemini-3.6-flash
